# Sao chép file này thành .env nếu cần đổi cấu hình. Không commit file .env.
HEADLESS=false
LOCALE=vi-VN
CURRENCY=VND
TIMEZONE=Asia/Ho_Chi_Minh
PAGE_TIMEOUT_MS=60000

# Giữ nguyên nhịp chậm để hạn chế bị Trip.com chặn.
MIN_DELAY=1.5
MAX_DELAY=3.5
API_MIN_DELAY=0.8
API_MAX_DELAY=1.8
MAX_CONCURRENCY=1

# Mặc định tắt proxy. Ứng dụng không xoay IP hoặc đổi vân tay trình duyệt.
TRIP_PROXY_ENABLED=false
TRIP_PROXY=
TRIP_PROXY_SERVER=
TRIP_PROXY_USERNAME=
TRIP_PROXY_PASSWORD=

RESPECT_ROBOTS=true
